# Local credentials.
.env
**/.env

# Python caches and local editor settings.
**/__pycache__/
*.pyc
**/.pytest_cache/
.idea/

# Disposable execution artifacts.
*.log
*.tmp
*.bak

# Publish result CSVs, but not execution caches or shards.
**/outputs/**
!**/outputs/**/
!**/outputs/**/*.csv
**/outputs/**/.cache/
**/outputs/**/shards_*/
**/.cache/
